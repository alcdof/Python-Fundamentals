originais = [2, 3, 5, 13, 17, 19, 23, 29, 43, 47]

print("Originais:", originais)

N = int(input("Quantos números deseja inserir? "))

for i in range(N): 
    j = 0
    num = int(input())

    if(num > originais[-1]):
        originais.append(num)
    else:
        while(originais[j] < num):
            j += 1
        originais.insert(j, num);

    print(originais)

